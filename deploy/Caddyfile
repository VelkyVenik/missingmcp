# /etc/caddy/Caddyfile on hydra — see deploy/README.md.
#
# missingmcp.com is proxied by Cloudflare (orange cloud), so every request
# arrives from a Cloudflare IP. Trust CF-Connecting-IP only from Cloudflare's
# ranges (https://www.cloudflare.com/ips/ — re-check when they change); a
# direct hit on the origin keeps its real remote address.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

missingmcp.com {
	# Cloudflare Origin CA certificate (Cloudflare SSL mode "Full (strict)").
	# Unlike ACME it works before DNS points here, so the origin can be tested
	# ahead of the cutover.
	tls /etc/caddy/certs/missingmcp.com.pem /etc/caddy/certs/missingmcp.com.key

	# Origin only answers Cloudflare: a direct hit on hydra's IP would skip
	# Cloudflare's WAF/DDoS layer. remote_ip is the TCP peer, not a header.
	# Same ranges as trusted_proxies above — keep the two lists in sync.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare 403

	reverse_proxy 127.0.0.1:8080 {
		# Exactly one entry: the client IP Caddy resolved above. The gateway's
		# per-IP rate limits key on it — never pass a client-supplied chain on.
		header_up X-Forwarded-For {client_ip}
	}
}

# Beszel dashboard (/opt/beszel) — plain Let's Encrypt, not behind Cloudflare.
hydra.venik.org {
	reverse_proxy 127.0.0.1:8090
}
